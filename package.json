{
  "name": "vatta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "วัฏฏะ (Vatta) — ป่าเสียงเรียก · a 2D contemplative game prototype (Thai / Lao / English) · built by https://bitos.space/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitoslabs/vatta.git"
  },
  "homepage": "https://bitos.space/",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "serve:py": "python3 -m http.server 5173",
    "check": "node tests/run.mjs --syntax-only",
    "test": "node tests/run.mjs --quick",
    "test:full": "node tests/run.mjs",
    "test:all": "node tests/run.mjs --all",
    "test:watch": "node tests/run.mjs --quick --watch",
    "perf:world": "node scripts/perf/world.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:check": "npm run build && node scripts/check-build.mjs",
    "deploy:check": "node deploy/check.mjs",
    "deploy:list": "node deploy/check.mjs --list"
  },
  "keywords": [
    "game",
    "canvas",
    "buddhism",
    "i18n"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "vite": "8.3.1"
  }
